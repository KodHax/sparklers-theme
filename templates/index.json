    "faq_section": {
      "type": "faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Os sparklers são seguros para casamentos?",
            "answer": "<p>Sim! Todos os nossos sparklers são certificados CE e cumprem as normas europeias de segurança. São de baixo fumo e adequados para uso interior e exterior.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Quanto tempo demora a entrega?",
            "answer": "<p>Enviamos em 24 horas úteis. A entrega em Portugal continental demora 1-2 dias úteis. Para ilhas, pode demorar 3-5 dias úteis.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Posso devolver se não usar?",
            "answer": "<p>Sim, tem 14 dias para devolver produtos não utilizados e em embalagem original. Contacte-nos para iniciar o processo de devolução.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Qual o tamanho ideal de sparkler para casamentos?",
            "answer": "<p>Recomendamos sparklers de 70cm ou 100cm para casamentos — duram mais tempo e criam um efeito visual mais impactante nas fotos e vídeos.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "As tochas de fumo mancham a roupa?",
            "answer": "<p>As nossas tochas de fumo são de alta qualidade e não mancham tecidos. Recomendamos manter uma distância mínima de 1 metro para maior segurança.</p>"
          }
        }
      },
      "block_order": ["q_1", "q_2", "q_3", "q_4", "q_5"],
      "settings": {
        "heading": "Perguntas Frequentes",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
