        "pf_1": {
          "type": "question",
          "settings": {
            "question": "Os sparklers são seguros para casamentos?",
            "answer": "<p>Sim! Todos os nossos sparklers são certificados CE e cumprem as normas europeias de segurança. São de baixo fumo e adequados para uso interior e exterior.</p>"
          }
        },
        "pf_2": {
          "type": "question",
          "settings": {
            "question": "Quantos sparklers preciso para o meu casamento?",
            "answer": "<p>Recomendamos 1 sparkler por convidado para a saída. Para um túnel de sparklers, considere 2 por pessoa. Para 100 convidados, sugerimos 100-200 unidades.</p>"
          }
        },
        "pf_3": {
          "type": "question",
          "settings": {
            "question": "Qual o tamanho ideal de sparkler?",
            "answer": "<p>Para casamentos: 70cm (~60s) ou 100cm (~90s) — mais tempo para fotos. Para bolos e mesas: 45cm (~35s).</p>"
          }
        },
        "pf_4": {
          "type": "question",
          "settings": {
            "question": "Como funciona o envio?",
            "answer": "<p>Encomendas processadas e enviadas em 24h úteis. Entrega em 1-2 dias úteis (Portugal Continental). Email com tracking enviado automaticamente.</p>"
          }
        },
        "pf_5": {
          "type": "question",
          "settings": {
            "question": "Posso devolver se não usar todos?",
            "answer": "<p>Sim, 14 dias para devoluções de produtos selados na embalagem original. Contacte-nos por email ou WhatsApp. Reembolso em 5-7 dias úteis.</p>"
          }
        }
