# ─── Loja de Origem ───
SOURCE_SHOP_URL=https://loja-origem.myshopify.com
# Opção A: Token direto (Custom App no Admin)
SOURCE_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opção B: OAuth (App via Partners/Dev Dashboard)
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=

# ─── Loja de Destino ───
DEST_SHOP_URL=https://loja-destino.myshopify.com
# Opção A: Token direto
DEST_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opção B: OAuth
DEST_CLIENT_ID=
DEST_CLIENT_SECRET=

# API Version
API_VERSION=2024-10

# Concurrency
MAX_CONCURRENT_REQUESTS=4
BATCH_SIZE=50

# Paths
DATA_DIR=./data
LOG_DIR=./logs

# OAuth callback port (default 8899)
OAUTH_CALLBACK_PORT=8899
