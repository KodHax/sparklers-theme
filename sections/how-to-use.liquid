

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="section-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style how-to-use"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  <div class="how-to-use__container">
    {% if section.settings.heading != blank %}
      <h2 class="how-to-use__title">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="how-to-use__steps">
      {% for block in section.blocks %}
        <div class="how-to-use__step" {{ block.shopify_attributes }}>
          <div class="how-to-use__step-number">
            {{ block.settings.step_number | default: forloop.index }}
          </div>
          {% if forloop.last == false %}
            <div class="how-to-use__connector"></div>
          {% endif %}
          {% if block.settings.image != blank %}
            <div class="how-to-use__image">
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400' }}
            </div>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h3 class="how-to-use__step-heading">{{ block.settings.heading }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="how-to-use__step-description">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .how-to-use__container {
    max-width: var(--full-page-grid-central-column-width);
    margin: 0 auto;
    padding-inline: var(--page-margin);
  }

  .how-to-use__title {
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    text-align: center;
    margin: 0 0 48px;
    font-size: var(--font-size--h2, 2rem);
  }

  .how-to-use__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 24px;
    }
  }

  .how-to-use__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .how-to-use__step-number {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #E6C78C;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .how-to-use__connector {
    display: none;

    @media screen and (min-width: 750px) {
      display: block;
      position: absolute;
      top: 24px;
      left: calc(50% + 32px);
      width: calc(100% - 64px);
      height: 2px;
      background: #E6C78C;
      opacity: 0.4;
    }
  }

  .how-to-use__image {
    width: 100%;
    max-width: 240px;
    margin-bottom: 16px;
    border-radius: 8px;
    overflow: hidden;
  }

  .how-to-use__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .how-to-use__step-heading {
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    font-size: 1rem;
    margin: 0 0 8px;
  }

  .how-to-use__step-description {
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    font-size: 0.875rem;
    margin: 0;
    opacity: 0.8;
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How to Use",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number",
          "default": "1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe this step in detail."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Como Usar"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "How to Use",
      "category": "Text",
      "blocks": [
        { "type": "step", "settings": { "step_number": "1", "heading": "Escolha o Produto", "description": "Selecione os sparklers ideais para a sua ocasião." } },
        { "type": "step", "settings": { "step_number": "2", "heading": "Prepare o Momento", "description": "Coloque os sparklers no bolo ou suporte." } },
        { "type": "step", "settings": { "step_number": "3", "heading": "Acenda e Celebre", "description": "Acenda com cuidado e aproveite o momento mágico." } }
      ]
    }
  ]
}
{% endschema %}
