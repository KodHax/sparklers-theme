

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="section-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style testimonials"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  <div class="testimonials__container">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials__title">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="testimonials__grid">
      {% for block in section.blocks %}
        <div class="testimonials__card" {{ block.shopify_attributes }}>
          <div class="testimonials__quote-mark" aria-hidden="true">&ldquo;</div>
          {% if block.settings.rating > 0 %}
            <div class="testimonials__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  <span class="testimonials__star testimonials__star--filled">&#9733;</span>
                {% else %}
                  <span class="testimonials__star">&#9733;</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if block.settings.quote != blank %}
            <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
          {% endif %}
          <div class="testimonials__author-info">
            {% if block.settings.image != blank %}
              <div class="testimonials__author-image">
                {{ block.settings.image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40,60,80' }}
              </div>
            {% endif %}
            <div>
              {% if block.settings.author != blank %}
                <cite class="testimonials__author-name">{{ block.settings.author }}</cite>
              {% endif %}
              {% if block.settings.role != blank %}
                <span class="testimonials__author-role">{{ block.settings.role }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .testimonials__container {
    max-width: var(--full-page-grid-central-column-width);
    margin: 0 auto;
    padding-inline: var(--page-margin);
  }

  .testimonials__title {
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    text-align: center;
    margin: 0 0 40px;
    font-size: var(--font-size--h2, 2rem);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  .testimonials__card {
    background: var(--color-background);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .testimonials__quote-mark {
    font-family: var(--font-heading--family);
    font-size: 3rem;
    line-height: 1;
    color: #E6C78C;
    height: 32px;
  }

  .testimonials__rating {
    display: flex;
    gap: 2px;
  }

  .testimonials__star {
    font-size: 1rem;
    color: #ddd;
  }

  .testimonials__star--filled {
    color: #E6C78C;
  }

  .testimonials__quote {
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
    font-style: italic;
    flex-grow: 1;
  }

  .testimonials__author-info {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .testimonials__author-image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .testimonials__author-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonials__author-name {
    display: block;
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    font-size: 0.875rem;
    font-style: normal;
    font-weight: 600;
  }

  .testimonials__author-role {
    display: block;
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    font-size: 0.8125rem;
    opacity: 0.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Maria S."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Noiva"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Os sparklers deram um toque mágico ao nosso casamento. Recomendo a 100%!"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author photo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "O Que Dizem os Nossos Clientes"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Text",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Maria S.", "role": "Noiva", "rating": 5, "quote": "Os sparklers deram um toque mágico ao nosso casamento. Recomendo a 100%!" } },
        { "type": "testimonial", "settings": { "author": "Ana P.", "role": "Organizadora de Eventos", "rating": 5, "quote": "Qualidade excepcional e entrega rápida. Já uso em todos os eventos." } },
        { "type": "testimonial", "settings": { "author": "João R.", "role": "Pai de Aniversariante", "rating": 5, "quote": "As crianças adoraram! Sem fumo e muito seguros." } }
      ]
    }
  ]
}
{% endschema %}
