

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="section-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style faq-section"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  <div class="faq-section__container">
    {% if section.settings.heading != blank %}
      <h2 class="faq-section__title">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="faq-section__list">
      {% for block in section.blocks %}
        <details class="faq-section__item" {{ block.shopify_attributes }}>
          <summary class="faq-section__question">
            <span>{{ block.settings.question }}</span>
            <svg class="faq-section__chevron" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="faq-section__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% if section.blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .faq-section__container {
    max-width: var(--full-page-grid-central-column-width);
    margin: 0 auto;
    padding-inline: var(--page-margin);
  }

  .faq-section__title {
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    text-align: center;
    margin: 0 0 40px;
    font-size: var(--font-size--h2, 2rem);
  }

  .faq-section__list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-section__item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .faq-section__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    font-family: var(--font-heading--family);
    color: var(--color-foreground-heading);
    font-size: 1rem;
    font-weight: 500;
    list-style: none;
    user-select: none;
  }

  .faq-section__question::-webkit-details-marker {
    display: none;
  }

  .faq-section__chevron {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: #E6C78C;
  }

  details[open] .faq-section__chevron {
    transform: rotate(180deg);
  }

  .faq-section__answer {
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    font-size: 0.9375rem;
    line-height: 1.7;
    padding-bottom: 20px;
    opacity: 0.85;
  }

  .faq-section__answer p {
    margin: 0 0 12px;
  }

  .faq-section__answer p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does this work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Provide a detailed answer here.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perguntas Frequentes"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "category": "Text",
      "blocks": [
        { "type": "question", "settings": { "question": "Os sparklers são seguros?", "answer": "<p>Sim, todos os nossos sparklers são certificados CE e cumprem as normas europeias de segurança. São sem fumo e adequados para uso interior.</p>" } },
        { "type": "question", "settings": { "question": "Quanto tempo demoram a chegar?", "answer": "<p>Enviamos em 24 horas úteis. A entrega em Portugal continental demora 1-2 dias úteis.</p>" } },
        { "type": "question", "settings": { "question": "Posso usar em bolos?", "answer": "<p>Sim! Os nossos sparklers para bolos são especialmente concebidos para uso alimentar, sem resíduos tóxicos.</p>" } }
      ]
    }
  ]
}
{% endschema %}
